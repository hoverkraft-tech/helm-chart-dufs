#!/usr/bin/env bash
#MISE dir="{{ config_root }}"
#MISE description="run tests"
#USAGE flag "--no-install" help="disable ct install" {}

NO_INSTALL="${usage_no_install:-false}"

mise run kubeconform --chart-dir "${HELM_CHART_NAME}"
mise run ct:lint

echo "$NO_INSTALL"

if [ "${NO_INSTALL}" = "false" ]; then
  mise run ct:install
fi
