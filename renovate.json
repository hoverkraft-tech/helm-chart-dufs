{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "timezone": "UTC",
  "schedule": ["before 6am on Friday"],
  "semanticCommits": "enabled",
  "labels": ["dependencies", "docker"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the chart appVersion in sync with the upstream sigoden/dufs image",
      "managerFilePatterns": ["/(^|/)Chart\\.ya?ml$/"],
      "matchStrings": [
        "appVersion:\\s*[\"']?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "depNameTemplate": "sigoden/dufs",
      "datasourceTemplate": "docker"
    }
  ]
}
